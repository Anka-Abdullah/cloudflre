# Local-only secrets for `pnpm run dev -- --number <nomor>`.
# Copy to `.dev.vars` (git-ignored) and adjust. Production values are set with
# `pnpm run secrets -- --number <nomor>` and never live in the repository.
#
#   cp .dev.vars.example .dev.vars
#
# `pnpm run secrets … --from-env` reads these same names from the environment,
# which is the recommended way to push a real key without putting it on the
# command line (and therefore into shell history).
#
# Non-secret settings (BOT_MODE, PAYMENT_DRY_RUN, TELEGRAM_ENABLED, PUBLIC_BASE_URL,
# KNOWLEDGE_MODE, OUTBOX_*, …) live in wrangler.jsonc `vars`, not here.

# Signs the webhook URL: /ingest/<INGEST_TOKEN>. Must match the URL pasted into
# the wuzapi dashboard.
INGEST_TOKEN=dev-ingest-token-change-me-0123456789
# Must match the HMAC key typed into the wuzapi dashboard for this number.
WUZAPI_HMAC_KEYS=dev-hmac-key-change-me-0123456789abcdef
# Signs relayed payloads so the old bot can verify them (BOT_MODE=off only).
DOWNSTREAM_HMAC_KEY=dev-downstream-key-change-me
# Optional DLQ alert target (Telegram alerting is configured separately).
# ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/wuzapi

# ---------------------------------------------------------------------------
# Automation (BOT_MODE=shadow|on). All optional while BOT_MODE=off.
# ---------------------------------------------------------------------------

# wuzapi REST API token for this number: used for /chat/send/*, /chat/presence
# and /user/contacts. Sent as the `Token` header.
WUZAPI_TOKEN=dev-wuzapi-token-change-me
# OpenAI-compatible endpoint key. Never commit a real key.
AI_API_KEY=dev-ai-key-change-me

# ---------------------------------------------------------------------------
# Order/payment database (FASE 5a). HTTP libsql — no Cloudflare binding.
# The schema is created on first use; verify with:
#   pnpm run smoke:turso -- --number <nomor> --local-secrets
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=dev-turso-token-change-me

# ---------------------------------------------------------------------------
# Payment gateway (FASE 5b).
# While PAYMENT_DRY_RUN=true (the default in wrangler.jsonc) no gateway is
# called: the link points at {PUBLIC_BASE_URL}/dry-run/<kode_bayar>.
# PAYMENT_CALLBACK_SECRET is required before PAYMENT_DRY_RUN=false: callbacks
# are refused when it is empty.
# ---------------------------------------------------------------------------
PAYMENT_API_KEY=dev-payment-key-change-me
PAYMENT_CALLBACK_SECRET=dev-payment-callback-secret-change-me

# ---------------------------------------------------------------------------
# Telegram admin approval card (FASE 5b).
# The admin chat must have pressed /start once; the bot answers with
# TELEGRAM_CHAT_ID=<id>, which is how this value is filled.
# TELEGRAM_WEBHOOK_SECRET is the value sent as X-Telegram-Bot-Api-Secret-Token
# when the webhook is registered with `setWebhook`.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=dev-telegram-token-change-me
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=dev-telegram-webhook-secret-change-me

# ---------------------------------------------------------------------------
# Operator surface (FASE 3-6): /admin/knowledge/sync, /admin/contacts/sync,
# /admin/chats/<jid>, /admin/orders/<kode>[/approve|/reject], /admin/outbox/flush,
# /admin/status. Bearer token; the routes answer 503 when this is empty (fail
# closed, never open).
# ---------------------------------------------------------------------------
ADMIN_API_KEY=dev-admin-key-change-me
