# Keep every pnpm artifact inside the repository so the Cloudflare tooling can
# run from a sandbox that cannot write to $HOME.
store-dir=.pnpm-store
cache-dir=.pnpm-cache
state-dir=.pnpm-state
# wrangler resolves its own log/cache dirs from WRANGLER_LOG_PATH and --persist-to
# (see scripts/instance.mjs) because ~/.wrangler is not writable in a sandbox.
