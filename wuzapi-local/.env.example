# Salin menjadi .env lalu sesuaikan.
#   cp .env.example .env

# Token admin dashboard wuzapi (http://localhost:8081/dashboard).
WUZAPI_ADMIN_TOKEN=change-me-admin-token

# 32 byte untuk AES-256. Simpan; kalau berubah, data terenkripsi tidak terbaca.
WUZAPI_GLOBAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Port dashboard/API di host (8080 sering dipakai instance lain).
WUZAPI_PORT=8081

# Webhook global: arahkan ke worker lokal (wrangler dev) dengan token ingest.
# Ganti <INGEST_TOKEN> dengan nilai di cloudflare/<nomor>/.dev.vars.
WUZAPI_GLOBAL_WEBHOOK=http://host.docker.internal:8790/ingest/dev-ingest-token-0123456789

# Harus sama dengan secret WUZAPI_HMAC_KEYS milik worker.
WUZAPI_GLOBAL_HMAC_KEY=dev-hmac-key-0123456789abcdef

# "json" (disarankan) atau "form".
WEBHOOK_FORMAT=json

WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_COUNT=2
WEBHOOK_RETRY_DELAY_SECONDS=5
LOG_LEVEL=info
